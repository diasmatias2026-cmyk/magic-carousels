# ============================================
# Magic Carousels — Variáveis de Ambiente
# Copie para .env.local e ajuste seus valores.
# ============================================

# ---------- URL do App ----------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"

# ---------- Pagamentos: Mercado Pago ----------
MERCADOPAGO_ACCESS_TOKEN="APP_USR-your-access-token"
MERCADOPAGO_WEBHOOK_SECRET="your-mercadopago-webhook-secret"
MERCADOPAGO_COLLECTOR_ID="your-collector-id"

# ---------- Provedor de IA (Texto) ----------
# Opções: mock | gemini | openai | openrouter
AI_PROVIDER="mock"

# Google Gemini (opcional, se AI_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI (opcional, se AI_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# OpenRouter (opcional, se AI_PROVIDER="openrouter")
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

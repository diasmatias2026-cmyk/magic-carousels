// Magic Carousels — modelo de dados
// Para trocar para PostgreSQL: provider = "postgresql" e DATABASE_URL apontando p/ o Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String     @default("")
  provider        String     @default("credentials") // credentials | google | apple | facebook
  plan            String     @default("FREE") // FREE | LIFETIME
  planSince       DateTime?
  cpf             String?
  phone           String?
  signupIp        String?
  lastIp          String?
  freeTrialsUsed  Int        @default(0) // máximo 1 para quem for FREE
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  brandKit        BrandKit?
  carousels       Carousel[]
  payments        Payment[]
  usage           UsageLog[]
}

model IpTracking {
  id         String   @id @default(cuid())
  ipAddress  String   @unique
  trialsUsed Int      @default(0)
  userCount  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BrandKit {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String  @default("")
  handle      String  @default("")
  avatarUrl   String? // data URL (local) ou URL pública
  primary     String  @default("#E1306C")
  secondary   String  @default("#833AB4")
  accent      String  @default("#FCAF45")
  bgColor     String  @default("#FFFFFF")
  textColor   String  @default("#111827")
  headingFont String  @default("poppins")
  bodyFont    String  @default("inter")
  useBrand    Boolean @default(false) // aplicar cores da marca sobre o template
}

model Carousel {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  niche      String
  templateId String
  prompt     String   @default("")
  slides     String // JSON serializado (Slide[])
  caption    String   @default("")
  format     String   @default("4:5") // 4:5 | 1:1 | 9:16
  useBrand   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Payment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String    @default("pagarme")
  orderId   String    @unique
  chargeId  String?
  method    String // pix | credit_card
  amount    Int // centavos
  installments Int    @default(1)
  status    String    @default("pending") // pending | paid | failed | canceled
  qrCode    String?
  qrExpires DateTime?
  paidAt    DateTime?
  raw       String? // último payload do gateway (JSON)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // ai_generation | carousel_created | export
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  source    String   @default("whatsapp_popup")
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email])
}

